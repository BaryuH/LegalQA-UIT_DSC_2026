# Local development defaults. Do not put secrets in this file.
LEGAL_RAG_CONFIG=configs/default.yaml
LEGAL_RAG_ENV=development

# SEDAR-SFT SS-04A server defaults (Linux RTX4090). Do not hard-code these in Python modules.
# Example on the GPU server:
# SEDAR_WORK_ROOT=/mnt/F/sedar-legalqa
# HF_HOME=/mnt/F/sedar-legalqa/hf-cache
# HF_HUB_CACHE=/mnt/F/sedar-legalqa/hf-cache/hub
# TRANSFORMERS_CACHE=/mnt/F/sedar-legalqa/hf-cache/transformers
# DATASETS_CACHE=/mnt/F/sedar-legalqa/datasets-cache
# TORCH_HOME=/mnt/F/sedar-legalqa/torch-cache
# SEDAR_VENV_DIR=/mnt/F/sedar-legalqa/venvs/sedar-sft
